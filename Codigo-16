<body>
    <pre class="codigofuente">
public class Cuadrado{
  // atributos
  int lado;
  boolean relleno;

  // métodos
  public int devolverArea(){
    return lado*lado;
  }

  public void rellenar(boolean r){
    relleno=r;
  }

  public void cambiarTamano(int l){
    lado=l;
  }

  public Cuadrado() {// constructor
    lado=15;
    relleno=false;
  }
}// fin clase Cuadrado
</pre>
</body>
</html>
